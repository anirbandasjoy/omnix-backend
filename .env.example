# ==============================================================================
# Auth2X Ultra - Environment Configuration
# ==============================================================================
# IMPORTANT NOTES:
# 1. Copy this file to .env and fill in your actual values
# 2. All values are validated at application startup
# 3. Invalid configuration will cause the app to crash with clear error messages
# 4. NEVER commit .env to version control
# 5. Required fields are marked with (REQUIRED)
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Environment: development, production, or test
NODE_ENV=development

# Server port (must be between 1-65535)
PORT=3000

# API prefix for all routes
API_PREFIX=api/v1

# Application name
APP_NAME=Auth2X Ultra

# Application URL (must be valid URL format)
APP_URL=http://localhost:3000

# CORS configuration
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Rate limiting (throttling)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging level: debug, info, warn, error
LOG_LEVEL=debug
LOG_PRETTY_PRINT=true

# ------------------------------------------------------------------------------
# DATABASE - PostgreSQL (Neon, Supabase, etc.)
# ------------------------------------------------------------------------------
# Full database URL (optional - individual DB_* vars will be used if not provided)
# Get your connection string from: https://console.neon.tech/
DATABASE_URL=postgresql://username:password@hostname/database_name?sslmode=require

# Individual database configuration (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth2x_ultra
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# REDIS - Redis Cloud, Upstash, or self-hosted
# ------------------------------------------------------------------------------
# Get your Redis connection from: https://redis.com/try-free/ or https://upstash.com/
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Alternative: Redis connection URL
# REDIS_URL=redis://default:password@hostname:port

# ------------------------------------------------------------------------------
# JWT TOKENS (REQUIRED - Minimum 32 characters)
# ------------------------------------------------------------------------------
# Access token secret (REQUIRED - must be at least 32 characters)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars

# Access token expiration (e.g., 15m, 1h, 7d)
JWT_ACCESS_EXPIRATION=15m

# Refresh token secret (REQUIRED - must be at least 32 characters)
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars

# Refresh token expiration
REFRESH_TOKEN_EXPIRATION=7d

# Token expiration times
VERIFICATION_TOKEN_EXPIRATION=24h
PASSWORD_RESET_TOKEN_EXPIRATION=1h

# ------------------------------------------------------------------------------
# OAUTH PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

# ------------------------------------------------------------------------------
# EMAIL - SMTP Configuration
# ------------------------------------------------------------------------------
# Email host (e.g., smtp.gmail.com, smtp.sendgrid.net)
EMAIL_HOST=smtp.gmail.com

# Email port (usually 587 for TLS, 465 for SSL)
EMAIL_PORT=587

# Email user (must be valid email format if provided)
EMAIL_USER=your-email@gmail.com

# Email password or app-specific password
EMAIL_PASSWORD=your-app-password

# From address (must be valid email format)
EMAIL_FROM=noreply@auth2x.com

# From name
EMAIL_FROM_NAME=Auth2X Ultra

# ------------------------------------------------------------------------------
# AWS S3 (Optional - For file storage)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=auth2x-avatars
AWS_CDN_URL=

# ------------------------------------------------------------------------------
# CLOUDINARY (Alternative to AWS S3)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=auth2x_avatar_preset

# ==============================================================================
# VALIDATION RULES
# ==============================================================================
# PORT:            Must be between 1-65535
# DATABASE_URL:    Must be valid URL if provided
# REDIS_URL:       Must be valid URL if provided
# JWT_*_SECRET:    Must be at least 32 characters (REQUIRED)
# EMAIL_USER:      Must be valid email format if provided
# EMAIL_FROM:      Must be valid email format
# APP_URL:         Must be valid URL format
# CALLBACK_URLs:   Must be valid URL format if provided
# LOG_LEVEL:       Must be one of: debug, info, warn, error
# NODE_ENV:        Must be one of: development, production, test
# ==============================================================================

# ==============================================================================
# QUICK START
# ==============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate secure secrets (use: openssl rand -base64 32)
# 3. Update JWT_ACCESS_SECRET and REFRESH_TOKEN_SECRET
# 4. Configure database (DATABASE_URL or individual DB_* vars)
# 5. Configure Redis (REDIS_URL or individual REDIS_* vars)
# 6. Start the application: npm run start:dev
# ==============================================================================
