# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Auth2X Ultra
APP_URL=http://localhost:3000

# Database - Neon PostgreSQL
# Get your connection string from Neon: https://console.neon.tech/
# Format: postgresql://username:password@hostname/database_name
DATABASE_URL=postgresql://username:password@hostname.neon.tech/database_name?sslmode=require

# Or use individual config (alternative to DATABASE_URL)
# DB_HOST=your-neon-host.neon.tech
# DB_PORT=5432
# DB_NAME=your-database-name
# DB_USER=your-username
# DB_PASSWORD=your-password
# DB_SSL=true
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# Redis - Redis Cloud / Upstash
# Get your connection from: https://redis.com/try-free/ or https://upstash.com/
REDIS_HOST=your-redis-host.redis.cloud.com
REDIS_PORT=17299
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_TLS=false
REDIS_DB=0

# Or use connection URL format (alternative to individual config)
# REDIS_URL=redis://default:password@hostname:port

# JWT - Access Tokens
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m

# JWT - Refresh Tokens
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
REFRESH_TOKEN_EXPIRATION=7d

# Verification Tokens
VERIFICATION_TOKEN_EXPIRATION=24h
PASSWORD_RESET_TOKEN_EXPIRATION=1h

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

# Email - SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@auth2x.com
EMAIL_FROM_NAME=Auth2X Ultra

# Cloudinary - Media Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=auth2x_avatar_preset

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Bull Queue (uses same Redis as above)
# QUEUE_REDIS_URL is optional - will use REDIS_URL if not provided
QUEUE_REDIS_URL=

# Logging
LOG_LEVEL=debug
LOG_PRETTY_PRINT=true

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=true
